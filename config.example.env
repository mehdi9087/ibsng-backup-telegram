# EXAMPLE ONLY. Do not commit real credentials.
IBSNG_CONTAINER=ibsng
IBSNG_DB=IBSng
HOST_LABEL=my-ibsng-server
BACKUP_DIR=/opt/ibsng/backups/telegram
RETENTION_HOURS=72
BACKUP_INTERVAL=1h
# Legacy INTERVAL_HOURS is still accepted when BACKUP_INTERVAL is unset.
TELEGRAM_SEND=true
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_DISABLE_NOTIFICATION=false
TELEGRAM_API_BASE=https://api.telegram.org
